# Copy this file to  .streamlit/secrets.toml  (same folder) and fill in the key you use.
# secrets.toml is listed in .gitignore, so it will not be pushed to GitHub by mistake.
# On Streamlit Community Cloud, paste the same lines into the app's Settings -> Secrets instead.

# ANTHROPIC_API_KEY = "sk-ant-..."
# GEMINI_API_KEY = "your-gemini-key"   # the one key the tool needs; officers never see or type it
